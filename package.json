{
  "name": "read.garden-core",
  "version": "1.0.0",
  "description": "Read Garden viewer core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinPar/read.garden-core.git"
  },
  "author": "Miguel Rodríguez",
  "bugs": {
    "url": "https://github.com/BinPar/read.garden-core/issues"
  },
  "homepage": "https://github.com/BinPar/read.garden-core#readme",
  "engines": {
    "node": ">=20.16.0"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf build;pnpm run build:bundle && pnpm run build:viewer",
    "build:expo": "node esbuild.expo.mjs",
    "build:bundle": "node esbuild.mjs",
    "build:dev": "node esbuild.dev.mjs",
    "build:viewer": "tspc --declaration --emitDeclarationOnly --project tsconfig.viewer.json",
    "dev": "concurrently \"node esbuild.dev.mjs\" \"tspc --declaration --emitDeclarationOnly --project tsconfig.viewer.json\" \"dotenv http-server ./web -c-1\" \"tsx watch --env-file=.env server/index.ts\"",
    "dev:expo": "concurrently \"pnpm run dev\" \"node esbuild.expo.mjs\"",
    "dev:build": "node esbuild.mjs",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "lint": "eslint",
    "preinstall": "npx only-allow pnpm",
    "publish:expo": "echo 'Not implemented yet'",
    "script:contents": "tsx --env-file=.env scripts/contents.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/eslint": "^8.56.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "8.1.0",
    "@typescript-eslint/parser": "8.1.0",
    "chalk": "^5.4.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv-cli": "^7.4.4",
    "esbuild": "0.24.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "express": "^4.21.2",
    "http-server": "^14.1.1",
    "js-base64": "^3.7.7",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.4.2",
    "redis": "^4.7.0",
    "ts-patch": "^3.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-transform-paths": "^3.5.3",
    "zod": "^3.24.1"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "8.1.0",
    "@typescript-eslint/parser": "8.1.0"
  },
  "packageManager": "pnpm@9.10.0",
  "readGarden": {
    "publish": {
      "olectioExpoPath": "../read.garden-expo-sample/olectio-viewer/core",
      "t3WebExpoPath": "../read.garden-t3/core",
      "rgAppExpoPath": "../read.garden-mobile/sdk-viewer"
    }
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0"
  }
}
